# Public site origin. Safe to expose. This project has no VITE_ or NEXT_PUBLIC_ client bundle.
FRONTEND_URL=https://goorganic.in

# Optional browser override. Leave empty in production so the site calls same-origin /api.
# GOORGANIC_API_URL=

# Server only — never prefix these with VITE_ or NEXT_PUBLIC_.
DATABASE_URL=postgresql://app_user:STRONG_PASSWORD@db-host:5432/goorganic_db?sslmode=verify-full

JWT_ACCESS_SECRET=REPLACE_WITH_MIN_64_CHAR_HEX_RANDOM_STRING
JWT_REFRESH_SECRET=REPLACE_WITH_MIN_64_CHAR_HEX_RANDOM_STRING

# Razorpay. KEY_ID is publishable and may be returned by create-order later.
# KEY_SECRET and WEBHOOK_SECRET must stay on the server.
RAZORPAY_KEY_ID=rzp_test_replace_me
RAZORPAY_KEY_SECRET=REPLACE_WITH_RAZORPAY_KEY_SECRET
RAZORPAY_WEBHOOK_SECRET=REPLACE_WITH_RAZORPAY_WEBHOOK_SECRET

# Porter. Used only by /api/porter/*.
PORTER_API_KEY=REPLACE_WITH_PORTER_API_KEY
PORTER_API_BASE_URL=https://porter-api.example

# Optional rate-limit store.
REDIS_URL=redis://:REDIS_STRONG_PASS@redis-host:6379
